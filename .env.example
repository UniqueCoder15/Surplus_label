# ==============================================================================
# SurplusLabel Server Configuration
# Copy this file to .env in the project root or in server/.env and fill in values.
# NEVER commit .env to version control. Keep CLOUDINARY_API_SECRET server-side only.
# ==============================================================================

# Server Network Settings
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL (Vercel)
# Set in Vercel to your deployed Render URL (e.g. https://surpluslabel-api.onrender.com)
# Leave blank in local development to use Vite's proxy.
VITE_API_URL=

# MongoDB Atlas (Required for production persistence)
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Use the SRV connection string for the app database user (never commit real credentials).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Legacy JSON import path (optional, used only by migrateJsonToMongo script)
# DATA_DIR=/var/data

# Cloudinary Server-Side Credentials (Required for live uploads)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Cloudinary Upload Folder Destination
CLOUDINARY_FOLDER=surpluslabel/food-labels

# Authentication & Security
# Generate a strong 32+ character random secret for production JWT signing
JWT_SECRET=your_jwt_secret_key_change_in_production
